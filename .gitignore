# Bazel output directories (IMPORTANT)
bazel-*
bazel-bin/
bazel-out/
bazel-testlogs/

# Bazel cache (local machine specific)
.bazel/
bazel-cache/

# Symlinks Bazel creates in your repo root
bazel-hello-bazel/   # (or bazel-<your-project-name>)
bazel-*/

# macOS (since you're on Mac)
.DS_Store

# Editor / IDE
.vscode/
.idea/

# Build artifacts (just in case)
*.o
*.obj
*.so
*.a
*.out